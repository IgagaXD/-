}

.title-type {
  font-size: 0.85em;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  background: #1e1e35;
  padding: 0.4em 1.2em;
  border-radius: 4px;
}

.title-meta {
  font-size: 0.85em;
  color: #94a3b8;
  line-height: 2;
  text-align: left;
  background: #1e1e35;
  padding: 1em 1.5em;
  border-radius: 6px;
  width: 100%;
  box-sizing: border-box;
}
.title-meta p { margin: 0; }

.title-city {
  font-size: 0.9em;
  color: #64748b;
  margin-top: auto;
}

/* ═══════════════════════════════════════════════
   СОДЕРЖАНИЕ / TOC
═══════════════════════════════════════════════ */
.toc-box {
  background: #1e1e35;
  border: 1px solid #3b3b5c;
  border-radius: 10px;
  padding: 1.5em 2em;
  line-height: 2.2;
}

.toc-box hr {
  border: none;
  border-top: 1px solid #3b3b5c;
  margin: 0.8em 0;
}

.toc-box a {
  display: block;
  padding-left: 1.2em;
  border-bottom: none;
  color: #f0abfc;
}

.toc-box a:hover {
  color: #ffffff;
  padding-left: 1.6em;
  transition: padding-left 0.15s;
}

.toc-box strong {
  color: #7dd3fc;
  display: block;
  margin-top: 0.3em;
  font-size: 0.95em;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

/* ═══════════════════════════════════════════════
   СКРЫТИЕ БЛОКА ПЕРЕМЕННЫХ CHAPBOOK
   Chapbook 1.2.x рендерит {var: val, ...} как
   первый параграф в tw-passage. Скрываем его.
═══════════════════════════════════════════════ */
tw-passage > p:first-child {
  display: none;
}

/* Восстанавливаем видимость для пассажей где первый <p>
   содержит реальный текст (не переменные).
   Chapbook-блок переменных рендерится без текста — пустой p. */
tw-passage > p:first-child:not(:empty) {
  display: block;
}

/* Скрываем vars через атрибуты Chapbook */
.vars, [data-cb-name="vars"], cb-vars {
  display: none !important;
}

/* Скрываем первый параграф если он выглядит как { key: val } */
tw-passage > p:first-of-type {
  /* JS обработает это — см. StoryScript */
}

hr {
  border: none;
  border-top: 1px solid #2e2e4e;
  margin: 1.5em 0;
}

hr { border: none; border-top: 1px solid #2e2e4e; margin: 1.5em 0; }