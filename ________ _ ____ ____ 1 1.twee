:: StoryScript [script]
window.addEventListener('load', function() {
  // Скрываем блоки переменных Chapbook которые рендерятся как текст
  function hideVarsBlocks() {
    // Chapbook рендерит { var: val } как первый <p> в tw-passage
    // Ищем все <p> содержащие паттерн { ... : ... }
    // Ищем все элементы в tw-passage
    var passage = document.querySelector('tw-passage');
    if (!passage) return;
    
    // Chapbook рендерит vars блок как <p> с текстом вида "{ key: val, key2: val2 }"
    // Проверяем все прямые дочерние элементы
    var children = passage.children;
    for (var i = 0; i < children.length; i++) {
      var el = children[i];
      var text = el.textContent.trim();
      // Паттерн vars-блока: { word: anything, ... } 
      if (/^\{\s*[\w_]+\s*:/.test(text) && text.endsWith('}')) {
        el.style.display = 'none';
        el.style.visibility = 'hidden';
        el.style.height = '0';
        el.style.overflow = 'hidden';
        el.style.margin = '0';
        el.style.padding = '0';
      }
    }
    
    // Также проверяем все <p> внутри passage
    var allP = passage.querySelectorAll('p');
    allP.forEach(function(el) {
      var text = el.textContent.trim();
      if (/^\{\s*[\w_]+\s*:/.test(text) && /\}\s*$/.test(text)) {
        el.style.cssText = 'display:none!important;height:0!important;margin:0!important;padding:0!important;';
      }
    });
  }
  
  // Запускаем при загрузке и при каждом переходе между пассажами
  hideVarsBlocks();
  
  // Twine/Chapbook меняет контент динамически — слушаем изменения DOM
  var observer = new MutationObserver(function(mutations) {
    hideVarsBlocks();
  });
  
  var passage = document.querySelector('tw-story');
  if (passage) {
    observer.observe(passage, { childList: true, subtree: true });
  }
});

:: StoryStylesheet [stylesheet]
/* === Скрываем блок вывода переменных Chapbook === */
tw-passage > p:first-child:empty,
.vars-block,
tw-passage > *:first-child {
  /* Chapbook выводит vars-блок как первый элемент — скрываем */
}
/* Более надёжный способ: через :has или через hidden span */
/* Chapbook 1.x рендерит блок переменных как скрытый — он уже не виден в 1.2.3 */
/* Но на случай если видно — добавим явное скрытие первого pre/code внутри passage */
tw-passage pre:first-child,
tw-passage code:first-child {
  display: none !important;
}

/* Скрываем строку с переменными если Chapbook показывает её как текст */
tw-passage > p:first-of-type:has(> code) {
  display: none !important;
}

body {
  background-color: #0f0f1a;
  color: #e0e0e0;
  font-family: Georgia, serif;
  font-size: 1.1em;
  line-height: 1.8;
  max-width: 780px;
  margin: 0 auto;
  padding: 2em 1.5em;
}

tw-passage {
  display: block;
}

h1, h2 {
  font-family: Arial, sans-serif;
  color: #a78bfa;
  letter-spacing: 0.04em;
}

h1 { font-size: 1.6em; border-bottom: 1px solid #3b3b5c; padding-bottom: 0.3em; }
h2 { font-size: 1.2em; color: #7dd3fc; }

a {
  color: #f0abfc;
  text-decoration: none;
  border-bottom: 1px dotted #f0abfc;
  transition: color 0.2s;
}
a:hover { color: #ffffff; border-bottom-color: #ffffff; }

blockquote {
  background: #1e1e35;
  border-left: 4px solid #a78bfa;
  margin: 1.2em 0;
  padding: 0.8em 1.2em;
  border-radius: 0 6px 6px 0;
  font-style: italic;
  color: #c4b5fd;
}

.hint {
  background: #1a2e1a;
  border-left: 4px solid #4ade80;
  padding: 0.6em 1em;
  border-radius: 0 6px 6px 0;
  color: #86efac;
  font-size: 0.95em;
  margin-top: 1em;
}

.error-hint {
  background: #2e1a1a;
  border-left: 4px solid #f87171;
  padding: 0.6em 1em;
  border-radius: 0 6px 6px 0;
  color: #fca5a5;
  font-size: 0.95em;
  margin-top: 1em;
}

.score-box {
  background: #1e1e35;
  border: 1px solid #4b4b7c;
  border-radius: 8px;
  padding: 1em 1.4em;
  margin: 1.2em 0;
  font-family: Arial, sans-serif;
  font-size: 0.95em;
}

.chapter-tag {
  font-family: Arial, sans-serif;
  font-size: 0.8em;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 0.5em;
}

